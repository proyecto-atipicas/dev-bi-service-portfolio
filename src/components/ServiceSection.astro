---
/**
 * ServiceSection.astro
 * --------------------
 * Plantilla común para cada servicio del portafolio. Renderiza un bloque
 * con la misma estructura narrativa para garantizar profesionalismo y un
 * flujo de venta uniforme:
 *
 *   1. Encabezado oscuro: número, etiqueta, título, propuesta de valor
 *      y video de portada en bucle.
 *   2. Cuerpo blanco: párrafo de la solución (nuestra entrega).
 *   3. Cuerpo gris claro: bullets de beneficio + casos con métrica.
 *   4. Vitrina de entregables: se inyecta por el slot por defecto
 *      (`VerticalTimeline` para reportería, `DeliverablesShowcase`
 *      para el resto de servicios).
 */
import type { ServiceDetail } from '../data/services';

interface Props {
  service: ServiceDetail;
  /** Numeración mostrada en el encabezado (p. ej. "01"). */
  number: string;
  /** Total de servicios; se renderiza al lado del número como "01 / 04". */
  total: string;
}

const { service, number, total } = Astro.props;

const headingId = `${service.anchor}-title`;
---

<section
  id={service.anchor}
  class="service-section relative scroll-mt-32 bg-white text-slate-900"
  aria-labelledby={headingId}
  data-service-anchor={service.anchor}
>
  {/* 1. Intro oscura: número, badge, título, valor, video */}
  <div
    class="relative isolate overflow-hidden bg-slate-950 py-14 text-slate-100 md:py-20"
    data-animate
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(59,130,246,0.18),transparent_55%)]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto grid w-[92%] max-w-7xl gap-10 lg:grid-cols-12 lg:gap-12">
      <header class="lg:col-span-6">
        <div class="flex items-baseline gap-3">
          <span
            class="font-mono text-3xl font-bold tabular-nums tracking-tight text-blue-300 md:text-4xl"
            data-animate-text
          >
            {number}
          </span>
          <span class="font-mono text-sm text-slate-400">/ {total}</span>
          <span class="ml-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400">
            Servicio
          </span>
        </div>
        <h2
          id={headingId}
          class="mt-4 text-balance text-3xl font-bold leading-tight tracking-tight text-white md:text-4xl lg:text-[2.5rem] lg:leading-tight"
          data-animate-text
        >
          {service.title}
        </h2>
        <p
          class="mt-4 max-w-xl text-pretty text-base leading-relaxed text-slate-300 md:text-lg md:leading-relaxed"
          data-animate-text
        >
          {service.valueSubtitle}
        </p>
      </header>

      <div class="lg:col-span-6">
        <div
          class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/40 shadow-2xl shadow-black/40 ring-1 ring-white/5"
        >
          <div class="relative aspect-video w-full bg-slate-950">
            <div
              class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-slate-950/85 via-transparent to-slate-950/30"
              aria-hidden="true"
            ></div>
            <video
              data-service-preview
              src={service.videoSrc}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={`Vista previa del servicio ${service.title}`}
              class="relative z-0 h-full w-full object-cover"
            ></video>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* 2. Nuestra entrega sobre fondo blanco (columna única, centrada). */}
  <div class="border-b border-slate-100 bg-white py-14 md:py-20" data-animate>
    <div class="mx-auto w-[92%] max-w-7xl">
      <article class="mx-auto max-w-3xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600" data-animate-text>
          Nuestra entrega
        </p>
        <h3
          class="mt-3 text-balance text-2xl font-bold tracking-tight text-slate-900 md:text-3xl"
          data-animate-text
        >
          Cómo lo solucionamos
        </h3>
        <p
          class="mt-5 text-pretty text-base leading-relaxed text-slate-700 md:text-[17px] md:leading-relaxed"
          data-animate-text
        >
          {service.solutionParagraph}
        </p>
      </article>
    </div>
  </div>

  {/* 3. Beneficios + métricas sobre gris claro con tarjetas más expresivas. */}
  <div class="bg-slate-50 py-14 md:py-20" data-animate>
    <div class="mx-auto grid w-[92%] max-w-7xl gap-10 lg:grid-cols-2 lg:gap-12">
      <section aria-label={`Bullets de alcance · ${service.title}`}>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600" data-animate-text>
          Alcance del servicio
        </p>
        <h3
          class="mt-3 text-balance text-xl font-bold tracking-tight text-slate-900 md:text-2xl"
          data-animate-text
        >
          Impacto del servicio
        </h3>
        <ul class="mt-6 grid gap-3.5" data-stagger>
          {service.benefits.map((text) => (
            <li
              class="benefit-card group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_8px_24px_-12px_rgba(15,23,42,0.12)] ring-1 ring-slate-900/[0.02] transition duration-300 hover:-translate-y-1 hover:border-blue-300/80 hover:shadow-[0_8px_28px_-12px_rgba(37,99,235,0.35)]"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 rounded-r-full bg-gradient-to-b from-blue-400 to-blue-600 transition-transform duration-300 group-hover:scale-y-100"
              ></span>
              <div class="flex items-start gap-4">
                <span
                  aria-hidden="true"
                  class="relative inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 text-white shadow-md shadow-blue-900/25 transition group-hover:scale-110 group-hover:shadow-blue-900/40"
                >
                  <svg viewBox="0 0 20 20" fill="currentColor" class="size-5">
                    <path
                      fill-rule="evenodd"
                      d="M16.704 5.296a1 1 0 0 1 0 1.408l-8 8a1 1 0 0 1-1.408 0l-4-4a1 1 0 1 1 1.408-1.408L8 12.59l7.296-7.295a1 1 0 0 1 1.408 0Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <p class="text-pretty text-[15px] font-medium leading-relaxed text-slate-800 md:text-base md:leading-relaxed">
                  {text}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-label={`Casos de éxito · ${service.title}`}>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600" data-animate-text>
          Casos de éxito demostrables
        </p>
        <h3
          class="mt-3 text-balance text-xl font-bold tracking-tight text-slate-900 md:text-2xl"
          data-animate-text
        >
          Logros
        </h3>
        <ol class="mt-6 grid gap-3.5" data-stagger>
          {service.successMetrics.map((text, idx) => (
            <li
              class="metric-card group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-gradient-to-br from-white to-slate-50 p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_8px_24px_-12px_rgba(15,23,42,0.12)] ring-1 ring-slate-900/[0.02] transition duration-300 hover:-translate-y-1 hover:border-blue-300/80 hover:shadow-[0_8px_28px_-12px_rgba(37,99,235,0.35)]"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-gradient-to-r from-blue-400 via-blue-500 to-blue-600 transition-transform duration-300 group-hover:scale-x-100"
              ></span>
              <div class="flex items-start gap-5">
                <span
                  aria-hidden="true"
                  class="relative flex size-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 font-mono text-lg font-bold tabular-nums text-blue-700 ring-1 ring-blue-100/80 transition group-hover:bg-blue-100 group-hover:ring-blue-200"
                >
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <p class="flex-1 pt-1 text-pretty text-[15px] leading-relaxed text-slate-700 md:text-base md:leading-relaxed">
                  {text}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>

  {/* 4. Vitrina de entregables: el contenido inyectado decide su propio fondo y ancho.
       Importante: NO se envuelve en `[data-animate]` porque la línea de tiempo de
       reportería es demasiado alta para alcanzar el `threshold: 0.15` del observer
       global y quedaría invisible. Cada hijo trae sus propias animaciones. */}
  <slot />
</section>
