---
/**
 * VerticalTimeline.astro
 * ----------------------
 * Línea de tiempo vertical (móvil/tablet) y horizontal (lg+).
 *
 * Diseño:
 *  - Vertical: tarjetas apiladas a la derecha del riel. Cada tarjeta muestra
 *    fecha, contexto y la lista de enlaces a los tableros publicados.
 *  - Horizontal (lg+): nodos uniformemente distribuidos sobre una línea
 *    horizontal. Cada nodo es un botón que abre un <dialog> modal con la
 *    información completa de la elección (fecha, contexto y enlaces).
 *  - Eventos `isHito` reciben marcador más grande, halo y acento dorado.
 *
 * Interactividad (delegada a `src/scripts/vertical-timeline.ts`):
 *  - IntersectionObserver para revelar tarjetas al hacer scroll.
 *  - Riel de progreso que se rellena conforme el usuario avanza.
 *  - Apertura/cierre exclusivo de modales horizontales con cierre por
 *    backdrop, botón X o tecla Escape (nativo del <dialog>).
 */
import type { TimelineEvent } from '../../data/timeline-elecciones';

interface Props {
  /** Eventos ordenados por fecha (asc.). */
  events: TimelineEvent[];
  /** Etiqueta superior pequeña (eyebrow). Opcional. */
  eyebrow?: string;
  /** Título de la sección. */
  heading: string;
  /** Bajada / descripción de la sección. */
  description?: string;
  /** ID base del bloque para anclas / aria. */
  id?: string;
}

const {
  events,
  eyebrow = 'Evolución del servicio',
  heading,
  description,
  id = 'linea-tiempo',
} = Astro.props;

const orderedEvents = [...events].sort((a, b) => a.date.localeCompare(b.date));

const MONTHS_ES = [
  'ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN',
  'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC',
];

const formatDateBadge = (iso: string): { day: string; monthYear: string } => {
  const [year, month, day] = iso.split('-');
  const idx = Math.max(0, Math.min(11, parseInt(month, 10) - 1));
  return {
    day: String(parseInt(day, 10)).padStart(2, '0'),
    monthYear: `${MONTHS_ES[idx]} ${year}`,
  };
};
---

<section
  id={id}
  class="vt-section relative isolate scroll-mt-20 overflow-hidden bg-slate-950 py-16 text-slate-100 md:py-24"
  aria-labelledby={`${id}-heading`}
  data-vertical-timeline
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_50%_-15%,rgba(59,130,246,0.18),transparent_55%)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-[92%] max-w-6xl">
    <header class="mb-10 max-w-3xl md:mb-14">
      <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-400" data-animate-text>
        {eyebrow}
      </p>
      <h2
        id={`${id}-heading`}
        class="mt-3 text-balance text-3xl font-bold tracking-tight text-white md:text-4xl"
        data-animate-text
      >
        {heading}
      </h2>
      {description && (
        <p
          class="mt-4 text-pretty text-base leading-relaxed text-slate-300 md:text-lg"
          data-animate-text
        >
          {description}
        </p>
      )}
    </header>

    <div class="vt-rail relative">
      <p class="vt-h-hint" aria-hidden="true">
        Pulsa cualquier nodo para abrir el detalle y los tableros de cada despliegue
      </p>
      <div class="vt-rail-track relative">
        {/* Riel base vertical (fondo) */}
        <div
          class="vt-rail-base pointer-events-none absolute top-0 bottom-0 left-[1.875rem] w-[4px] -translate-x-1/2 rounded-full bg-gradient-to-b from-blue-500/30 via-blue-500/40 to-amber-300/30 md:left-[8rem]"
          aria-hidden="true"
        ></div>
        {/* Riel de progreso (animado por JS) */}
        <div
          class="vt-rail-progress pointer-events-none absolute top-0 left-[1.875rem] w-[4px] origin-top -translate-x-1/2 scale-y-0 rounded-full bg-gradient-to-b from-blue-400 via-blue-500 to-amber-300 shadow-[0_0_16px_rgba(96,165,250,0.55)] md:left-[8rem]"
          aria-hidden="true"
          style="height: 100%;"
        ></div>
        {/* Cometa que recorre el riel base */}
        <div
          class="vt-rail-comet pointer-events-none absolute left-[1.875rem] h-16 w-2 -translate-x-1/2 rounded-full bg-gradient-to-b from-transparent via-blue-200 to-transparent opacity-80 blur-[2px] md:left-[8rem]"
          aria-hidden="true"
        ></div>

        <ol
          class="vt-events relative list-none space-y-14 ps-0 md:space-y-20"
          style={`--vt-count: ${orderedEvents.length}`}
          role="list"
        >
        {
          orderedEvents.map((event, index) => {
            const anchorId = `${id}-${event.id}`;
            const modalId = `${id}-modal-${event.id}`;
            const badge = formatDateBadge(event.date);
            const isAbove = index % 2 === 0;
            const hasLinks = event.embeds.length > 0;
            return (
              <li
                id={anchorId}
                class="vt-event relative min-w-0 scroll-mt-32 md:scroll-mt-40"
                data-vt-event
                data-vt-event-id={event.id}
                data-vt-hito={event.isHito ? 'true' : 'false'}
                data-vt-side={isAbove ? 'above' : 'below'}
              >
                {/* ---------- Modo vertical (móvil/tablet) ---------- */}
                <div class="vt-event-vertical relative max-lg:block lg:hidden">
                  <span
                    aria-hidden="true"
                    class:list={[
                      'vt-marker-anchor absolute top-2 left-[1.875rem] -translate-x-1/2 md:left-[8rem]',
                      event.isHito ? 'size-6' : 'size-4',
                    ]}
                  >
                    <span
                      class:list={[
                        'vt-marker block size-full rounded-full ring-4',
                        event.isHito
                          ? 'bg-amber-300 ring-amber-300/30'
                          : 'bg-blue-400 ring-blue-400/25',
                      ]}
                    >
                      {event.isHito && (
                        <span class="vt-marker-pulse absolute inset-0 rounded-full bg-amber-300/70"></span>
                      )}
                    </span>
                  </span>

                  <time
                    datetime={event.date}
                    class:list={[
                      'vt-date-side hidden md:absolute md:top-0 md:left-0 md:block md:w-[6.75rem] md:text-right',
                    ]}
                  >
                    <span
                      class:list={[
                        'block font-mono text-3xl font-bold leading-none tabular-nums tracking-tight',
                        event.isHito ? 'text-amber-200' : 'text-white',
                      ]}
                    >
                      {badge.day}
                    </span>
                    <span
                      class:list={[
                        'mt-1 block font-mono text-[11px] font-semibold uppercase tracking-[0.18em]',
                        event.isHito ? 'text-amber-300/85' : 'text-blue-300/85',
                      ]}
                    >
                      {badge.monthYear}
                    </span>
                  </time>

                  <article class="vt-card relative ml-14 md:ml-[11rem]" data-vt-card>
                    <div
                      class:list={[
                        'rounded-2xl border bg-slate-900/65 p-5 shadow-lg shadow-black/30 ring-1 ring-white/5 backdrop-blur md:p-6',
                        event.isHito
                          ? 'border-amber-300/35 hover:border-amber-300/55'
                          : 'border-white/10 hover:border-blue-400/40',
                        'transition duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-blue-950/40',
                      ]}
                    >
                      <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        {event.isHito && (
                          <span class="inline-flex items-center gap-1 rounded-full border border-amber-300/40 bg-amber-500/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-amber-100">
                            <span aria-hidden="true">★</span> Hito
                          </span>
                        )}
                        <time
                          datetime={event.date}
                          class:list={[
                            'font-mono text-[11px] font-semibold tabular-nums uppercase tracking-[0.16em] md:hidden',
                            event.isHito ? 'text-amber-200/90' : 'text-blue-300/90',
                          ]}
                        >
                          {event.dateLabel}
                        </time>
                      </header>

                      <h3 class="mt-2 text-pretty text-lg font-semibold leading-snug tracking-tight text-white md:text-xl">
                        {event.title}
                      </h3>

                      {event.location && (
                        <p class="mt-1 text-[12px] uppercase tracking-[0.16em] text-slate-400">
                          {event.location}
                        </p>
                      )}

                      {event.description && (
                        <p class="mt-3 text-pretty text-sm leading-relaxed text-slate-300 md:text-[15px] md:leading-relaxed">
                          {event.description}
                        </p>
                      )}

                      {hasLinks ? (
                        <ul
                          class="mt-5 grid gap-2 sm:grid-cols-2"
                          aria-label={`Tableros publicados de ${event.title}`}
                        >
                          {event.embeds.map((embed, embedIndex) => (
                            <li class="min-w-0">
                              {embed.url !== '#' ? (
                                <a
                                  href={embed.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class:list={[
                                    'group flex items-start gap-3 rounded-xl border bg-slate-950/60 p-3 transition hover:-translate-y-0.5',
                                    event.isHito
                                      ? 'border-amber-300/25 hover:border-amber-300/55 hover:bg-amber-500/5'
                                      : 'border-white/10 hover:border-blue-400/45 hover:bg-blue-500/5',
                                  ]}
                                >
                                  <span
                                    class:list={[
                                      'mt-0.5 font-mono text-[10px] font-semibold uppercase tabular-nums tracking-[0.18em]',
                                      event.isHito ? 'text-amber-200/90' : 'text-blue-300/90',
                                    ]}
                                  >
                                    {String(embedIndex + 1).padStart(2, '0')}
                                  </span>
                                  <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-semibold text-white group-hover:text-blue-100">
                                      {embed.title}
                                    </span>
                                    {embed.subtitle && (
                                      <span class="mt-0.5 block truncate text-[11px] uppercase tracking-[0.14em] text-slate-400">
                                        {embed.subtitle}
                                      </span>
                                    )}
                                  </span>
                                  <span
                                    class="mt-0.5 text-blue-300 transition group-hover:translate-x-0.5 group-hover:text-blue-200"
                                    aria-hidden="true"
                                  >
                                    ↗
                                  </span>
                                </a>
                              ) : (
                                <span class="flex items-start gap-3 rounded-xl border border-dashed border-slate-700 bg-slate-900/40 p-3 text-sm text-slate-400">
                                  <span class="mt-0.5 font-mono text-[10px] font-semibold uppercase tabular-nums tracking-[0.18em] text-slate-500">
                                    {String(embedIndex + 1).padStart(2, '0')}
                                  </span>
                                  <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-semibold text-slate-300">
                                      {embed.title}
                                    </span>
                                    <span class="mt-0.5 block text-[11px] uppercase tracking-[0.14em] text-slate-500">
                                      Pendiente de publicación
                                    </span>
                                  </span>
                                </span>
                              )}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p
                          class="mt-5 rounded-xl border border-dashed border-slate-700 bg-slate-900/40 p-4 text-sm leading-relaxed text-slate-400"
                          role="status"
                        >
                          Despliegue pendiente: el espacio está reservado para incorporar los tableros
                          cuando estén publicados.
                        </p>
                      )}
                    </div>
                  </article>
                </div>

                {/* ---------- Modo horizontal (lg+): trigger del modal ---------- */}
                <button
                  type="button"
                  class="vt-h vt-h-summary hidden lg:block"
                  data-vt-h-side={isAbove ? 'above' : 'below'}
                  data-vt-open-modal={modalId}
                  aria-haspopup="dialog"
                  aria-controls={modalId}
                  aria-label={`${event.title}, ${event.dateLabel}. Abrir detalles y tableros.`}
                >
                  <span class:list={['vt-h-stick', isAbove ? 'vt-h-stick-above' : 'vt-h-stick-below']}>
                    <time datetime={event.date} class="vt-h-label" aria-hidden="true">
                      <span class:list={['vt-h-day', event.isHito ? 'text-amber-100' : 'text-white']}>
                        {badge.day}
                      </span>
                      <span class:list={['vt-h-month', event.isHito ? 'text-amber-300/90' : 'text-blue-300/90']}>
                        {badge.monthYear.replace(' ', ' ')}
                      </span>
                    </time>
                    <span class:list={['vt-h-name', event.isHito ? 'text-amber-100/90' : 'text-slate-200/85']}>
                      {event.title}
                    </span>
                    <span class="vt-h-line" aria-hidden="true" />
                  </span>

                  <span
                    class:list={[
                      'vt-marker vt-h-dot',
                      event.isHito ? 'vt-h-dot-hito' : '',
                    ]}
                    aria-hidden="true"
                  >
                    {event.isHito && (
                      <span class="vt-marker-pulse absolute inset-0 rounded-full bg-amber-300/70" />
                    )}
                  </span>
                </button>

                {/* ---------- Modal nativo del nodo (lg+) ---------- */}
                <dialog
                  id={modalId}
                  class="vt-modal"
                  data-vt-modal
                  data-vt-modal-id={modalId}
                  data-vt-hito={event.isHito ? 'true' : 'false'}
                  aria-labelledby={`${modalId}-title`}
                >
                  <form method="dialog" class="vt-modal-close-form">
                    <button
                      type="submit"
                      class="vt-modal-close"
                      aria-label="Cerrar"
                    >
                      <span aria-hidden="true">×</span>
                    </button>
                  </form>

                  <div class="vt-modal-content">
                    <header class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                      {event.isHito && (
                        <span class="inline-flex items-center gap-1 rounded-full border border-amber-300/40 bg-amber-500/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-amber-100">
                          <span aria-hidden="true">★</span> Hito
                        </span>
                      )}
                      <time
                        datetime={event.date}
                        class:list={[
                          'font-mono text-[11px] font-semibold uppercase tracking-[0.16em] tabular-nums',
                          event.isHito ? 'text-amber-200/90' : 'text-blue-300/90',
                        ]}
                      >
                        {event.dateLabel}
                      </time>
                    </header>

                    <h3
                      id={`${modalId}-title`}
                      class="mt-3 text-pretty text-xl font-semibold leading-snug tracking-tight text-white md:text-2xl"
                    >
                      {event.title}
                    </h3>

                    {event.location && (
                      <p class="mt-1 text-[11px] uppercase tracking-[0.16em] text-slate-400">
                        {event.location}
                      </p>
                    )}

                    {event.description && (
                      <p class="mt-4 text-pretty text-[13px] leading-relaxed text-slate-300 md:text-sm">
                        {event.description}
                      </p>
                    )}

                    {hasLinks ? (
                      <>
                        <p class="mt-6 text-[11px] font-semibold uppercase tracking-[0.18em] text-blue-300/85">
                          Tableros publicados
                        </p>
                        <ul
                          class="mt-3 grid gap-2"
                          aria-label={`Tableros publicados de ${event.title}`}
                        >
                          {event.embeds.map((embed, embedIndex) => (
                            <li class="min-w-0">
                              {embed.url !== '#' ? (
                                <a
                                  href={embed.url}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class:list={[
                                    'group flex items-start gap-3 rounded-xl border bg-slate-950/60 p-3 transition hover:-translate-y-0.5',
                                    event.isHito
                                      ? 'border-amber-300/25 hover:border-amber-300/55 hover:bg-amber-500/5'
                                      : 'border-white/10 hover:border-blue-400/45 hover:bg-blue-500/5',
                                  ]}
                                >
                                  <span
                                    class:list={[
                                      'mt-0.5 font-mono text-[10px] font-semibold uppercase tabular-nums tracking-[0.18em]',
                                      event.isHito ? 'text-amber-200/90' : 'text-blue-300/90',
                                    ]}
                                  >
                                    {String(embedIndex + 1).padStart(2, '0')}
                                  </span>
                                  <span class="min-w-0 flex-1">
                                    <span class="block text-sm font-semibold text-white group-hover:text-blue-100">
                                      {embed.title}
                                    </span>
                                    {embed.subtitle && (
                                      <span class="mt-0.5 block text-[11px] uppercase tracking-[0.14em] text-slate-400">
                                        {embed.subtitle}
                                      </span>
                                    )}
                                    {embed.description && (
                                      <span class="mt-1 block text-[12px] leading-relaxed text-slate-400">
                                        {embed.description}
                                      </span>
                                    )}
                                  </span>
                                  <span
                                    class="mt-0.5 text-blue-300 transition group-hover:translate-x-0.5 group-hover:text-blue-200"
                                    aria-hidden="true"
                                  >
                                    ↗
                                  </span>
                                </a>
                              ) : (
                                <span class="flex items-start gap-3 rounded-xl border border-dashed border-slate-700 bg-slate-900/40 p-3 text-sm text-slate-400">
                                  <span class="mt-0.5 font-mono text-[10px] font-semibold uppercase tabular-nums tracking-[0.18em] text-slate-500">
                                    {String(embedIndex + 1).padStart(2, '0')}
                                  </span>
                                  <span class="min-w-0 flex-1">
                                    <span class="block text-sm font-semibold text-slate-300">
                                      {embed.title}
                                    </span>
                                    <span class="mt-0.5 block text-[11px] uppercase tracking-[0.14em] text-slate-500">
                                      Pendiente de publicación
                                    </span>
                                  </span>
                                </span>
                              )}
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <p
                        class="mt-5 rounded-lg border border-dashed border-slate-600 bg-slate-950/50 p-3 text-[12px] leading-relaxed text-slate-400"
                        role="status"
                      >
                        Despliegue pendiente: el espacio está reservado para incorporar los tableros
                        cuando estén publicados.
                      </p>
                    )}
                  </div>
                </dialog>
              </li>
            );
          })
        }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hace que el card y demás piezas conserven el estado animado por anime.js;
     anime.js arranca desde estilos inline aplicados en `prepareEvents`. */
  .vt-section :global([data-vt-card]) {
    will-change: opacity, transform;
  }
  .vt-section :global(.vt-marker-anchor) {
    /* contenedor de posicionamiento: no anima, solo conserva el centrado. */
    display: block;
  }
  .vt-section :global(.vt-marker) {
    position: relative;
    box-shadow: 0 0 0 4px rgba(15, 23, 42, 0.95);
    will-change: transform, opacity, box-shadow;
  }

  /* Glow continuo y suave en TODOS los marcadores (más sutil para no-hitos). */
  @keyframes vt-marker-soft-glow {
    0%, 100% {
      box-shadow:
        0 0 0 4px rgba(15, 23, 42, 0.95),
        0 0 0 0 rgba(96, 165, 250, 0);
    }
    50% {
      box-shadow:
        0 0 0 4px rgba(15, 23, 42, 0.95),
        0 0 18px 2px rgba(96, 165, 250, 0.45);
    }
  }
  @keyframes vt-marker-soft-glow-hito {
    0%, 100% {
      box-shadow:
        0 0 0 4px rgba(15, 23, 42, 0.95),
        0 0 0 0 rgba(252, 211, 77, 0);
    }
    50% {
      box-shadow:
        0 0 0 4px rgba(15, 23, 42, 0.95),
        0 0 22px 4px rgba(252, 211, 77, 0.55);
    }
  }
  .vt-section :global([data-vt-hito='false'] .vt-marker) {
    animation: vt-marker-soft-glow 3.2s ease-in-out infinite;
  }
  .vt-section :global([data-vt-hito='true'] .vt-marker) {
    animation: vt-marker-soft-glow-hito 2.4s ease-in-out infinite;
  }

  /* Pulso fuerte solo para hitos (anillo expansivo dentro del marcador). */
  @keyframes vt-marker-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    70% { transform: scale(2.4); opacity: 0; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  .vt-section :global(.vt-marker-pulse) {
    animation: vt-marker-pulse 2.4s ease-out infinite;
  }

  /* Ripple "ping" one-shot cuando el evento entra al viewport por primera vez. */
  .vt-section :global(.vt-marker)::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    background: rgba(96, 165, 250, 0.6);
    opacity: 0;
    pointer-events: none;
  }
  .vt-section :global([data-vt-hito='true'] .vt-marker)::before {
    background: rgba(252, 211, 77, 0.65);
  }
  @keyframes vt-marker-ping {
    0% { transform: scale(1); opacity: 0.85; }
    80% { transform: scale(2.8); opacity: 0; }
    100% { transform: scale(2.8); opacity: 0; }
  }
  .vt-section :global([data-vt-arrived='true'] .vt-marker)::before {
    animation: vt-marker-ping 0.95s ease-out;
  }

  /* Cometa que recorre el riel de forma continua. */
  @keyframes vt-rail-comet {
    0%   { top: -10%; opacity: 0; }
    8%   { opacity: 0.85; }
    92%  { opacity: 0.85; }
    100% { top: 110%; opacity: 0; }
  }
  .vt-section :global(.vt-rail-comet) {
    top: -10%;
    animation: vt-rail-comet 5s ease-in-out infinite;
  }

  /* Hover de tarjeta con micro-flotación y brillo. */
  .vt-section :global([data-vt-card] > div) {
    transition:
      transform 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      box-shadow 320ms cubic-bezier(0.22, 0.61, 0.36, 1),
      border-color 320ms ease;
  }
  .vt-section :global([data-vt-card]:hover > div) {
    transform: translateY(-3px);
  }

  .vt-section :global(.vt-jumper-track) {
    scrollbar-width: none;
  }
  .vt-section :global(.vt-jumper-track::-webkit-scrollbar) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .vt-section :global([data-vt-card]) {
      opacity: 1 !important;
      transform: none !important;
    }
    .vt-section :global(.vt-marker),
    .vt-section :global(.vt-marker-pulse),
    .vt-section :global(.vt-rail-comet) {
      animation: none !important;
    }
  }

  /* Hint en la zona del riel horizontal (sólo lg+). Se desvanece cuando hay un
     modal abierto, marcado por el script con `data-vt-modal-open` en la sección. */
  .vt-section :global(.vt-h-hint) {
    display: none;
  }
  @media (min-width: 1024px) {
    .vt-section :global(.vt-h-hint) {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--vt-row-height) + 1rem);
      margin: 0;
      text-align: center;
      font-size: 0.7rem;
