---
/**
 * Header global del sitio. Una sola fila: logo + sub-nav de las secciones del
 * portafolio (anclas internas) + CTA de contacto. Sticky en la parte superior
 * para que la navegación dentro de la landing se sienta continua.
 */

/** Secciones del portafolio; el `id` coincide con el `id` de cada `<section>`. */
const navSections = [
  { id: 'pilares', num: '01', label: 'Pilares' },
  { id: 'journeys', num: '02', label: 'Rutas' },
  { id: 'verticales', num: '03', label: 'Líneas de negocio' },
  { id: 'evidencia', num: '04', label: 'Evidencia' },
  { id: 'continuos', num: '05', label: 'Continuos' },
];
---

<header
  class="sticky top-0 z-30 border-b border-white/10 bg-slate-950 text-slate-100 backdrop-blur-md supports-[backdrop-filter]:bg-slate-950/95"
  data-services-subnav
>
  <div
    class="mx-auto flex w-[92%] max-w-7xl items-center gap-4 py-3 md:gap-6 md:py-4"
  >
    <a
      href="/"
      class="brand-lockup group inline-flex shrink-0 items-center gap-2.5 transition hover:opacity-95 md:gap-3"
      aria-label="Linktic · DataVision (Business Intelligence)"
      data-animate-nav
    >
      <img
        src="/logo-negro-LinkTIC.svg"
        alt="Linktic"
        width="120"
        height="18"
        class="brand-lockup-logo h-5 w-auto md:h-[22px]"
        loading="eager"
        decoding="async"
      />
      <span
        class="hidden h-5 w-px bg-white/15 sm:inline-block md:h-6"
        aria-hidden="true"
      ></span>
      <span
        class="hidden text-base font-bold leading-none text-white sm:inline-block md:text-lg"
      >
        Data<span class="text-blue-400">Vision</span>
      </span>
    </a>

    <nav
      class="min-w-0 flex-1"
      aria-label="Navegación del portafolio"
    >
      <ul
        class="flex items-center gap-2 overflow-x-auto py-1 text-[13px]"
        role="list"
      >
        {navSections.map((section) => (
          <li class="shrink-0">
            <a
              href={`#${section.id}`}
              data-subnav-link={section.id}
              data-animate-nav
              class="group inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 font-medium text-slate-200 transition hover:border-blue-400/50 hover:bg-blue-500/15 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              <span
                class="font-mono text-[11px] font-semibold tabular-nums text-slate-500 transition group-hover:text-blue-300"
              >
                {section.num}
              </span>
              <span class="whitespace-nowrap">{section.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="#contacto"
      class="cta-header-attention relative hidden shrink-0 rounded-full border border-blue-400/45 bg-blue-500/20 px-4 py-2 text-sm font-semibold text-white transition hover:border-blue-300/70 hover:bg-blue-500/35 hover:shadow-md hover:shadow-blue-950/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 md:inline-flex"
      data-animate-nav
    >
      Contactar al área BI
    </a>
  </div>
</header>

<style>
  [data-services-subnav] nav ul {
    scrollbar-width: none;
  }
  [data-services-subnav] nav ul::-webkit-scrollbar {
    display: none;
  }
  [data-services-subnav] a[data-subnav-link][data-active='true'] {
    background-color: rgba(59, 130, 246, 0.22);
    border-color: rgba(96, 165, 250, 0.55);
    color: white;
  }
  [data-services-subnav] a[data-subnav-link][data-active='true'] span:first-child {
    color: rgb(147 197 253);
  }
  /* Logo de Linktic: el SVG original es negro (#171725). Lo blanqueamos
     para que se lea sobre el header oscuro (bg-slate-950) sin tener que
     duplicar el asset en otra versión cromática. */
  .brand-lockup-logo {
    filter: brightness(0) invert(1);
    transition: filter 0.3s ease;
  }
  .brand-lockup:hover .brand-lockup-logo {
    filter: brightness(0) invert(1) drop-shadow(0 0 6px rgba(96, 165, 250, 0.35));
  }
</style>
