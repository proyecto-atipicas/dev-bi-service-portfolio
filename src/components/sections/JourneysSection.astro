---
/**
 * JourneysSection.astro
 * ---------------------
 * Journeys empaquetados: formas de empezar con alcance, tiempo y compromiso
 * acotados. Bloque claro (white / slate-50) que rompe el ritmo de las
 * secciones oscuras; tarjetas con borde-acento a la izquierda.
 */
import { journeys } from '../../data/journeys';
---

<section
  id="journeys"
  class="relative scroll-mt-32 border-y border-slate-200 bg-slate-50 py-16 text-slate-900 md:py-24"
  aria-labelledby="journeys-heading"
  data-animate
>
  <div class="mx-auto w-[92%] max-w-7xl">
    <header class="mb-10 max-w-3xl md:mb-12">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600"
        data-animate-text
      >
        Journeys empaquetados
      </p>
      <h2
        id="journeys-heading"
        class="mt-3 text-balance text-3xl font-bold tracking-tight text-slate-900 md:text-4xl"
        data-animate-text
      >
        Formas de empezar, de menor a mayor compromiso
      </h2>
      <p
        class="mt-4 text-pretty text-base leading-relaxed text-slate-600 md:text-lg"
        data-animate-text
      >
        Cada journey empaqueta alcance, tiempo y nivel de compromiso. Van de la exploración de bajo
        riesgo a la plataforma completa y la migración desde sistemas heredados.
      </p>
    </header>

    <div class="grid gap-4 md:gap-5" data-stagger role="list">
      {
        journeys.map((journey) => (
          <article
            role="listitem"
            class:list={[
              'group rounded-2xl border border-slate-200 border-l-4 bg-white p-6 shadow-sm ring-1 ring-slate-900/[0.03] transition duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-blue-900/10 md:p-7',
              journey.accent,
            ]}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <h3 class="text-lg font-bold tracking-tight text-slate-900">{journey.name}</h3>
                <div class="flex flex-wrap gap-1.5">
                  {journey.tags.map((tag) => (
                    <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-medium text-slate-600">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <span class="font-mono text-[12px] font-semibold tabular-nums text-blue-600">
                {journey.time}
              </span>
            </div>
            <p class="mt-3 text-[14px] leading-relaxed text-slate-600">
              <span class="font-semibold text-slate-900">Para:</span> {journey.target}
            </p>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-600">{journey.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
