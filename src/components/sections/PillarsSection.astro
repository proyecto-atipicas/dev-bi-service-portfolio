---
/**
 * PillarsSection.astro
 * --------------------
 * Pilares de capacidad: tres bloques que concentran las capacidades del área
 * y reagrupan los servicios del portafolio. Cada pilar lista sus servicios con
 * la ficha "Para / Incluye" y una prueba corta opcional.
 *
 * Mantiene la línea gráfica oscura del sitio (bg-slate-950 + acentos blue).
 */
import { pillars } from '../../data/pillars';
---

<section
  id="pilares"
  class="relative scroll-mt-32 overflow-hidden bg-slate-950 py-16 text-slate-100 md:py-24"
  aria-labelledby="pilares-heading"
  data-animate
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_50%_-15%,rgba(59,130,246,0.16),transparent_55%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-[92%] max-w-7xl">
    <header class="mb-12 max-w-3xl md:mb-14">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-400"
        data-animate-text
      >
        Pilares de capacidad
      </p>
      <h2
        id="pilares-heading"
        class="mt-3 text-balance text-3xl font-bold tracking-tight text-white md:text-4xl"
        data-animate-text
      >
        Tres pilares que vuelven el dato una decisión
      </h2>
      <p
        class="mt-4 text-pretty text-base leading-relaxed text-slate-300 md:text-lg"
        data-animate-text
      >
        Las capacidades del área se concentran en tres pilares —de la confiabilidad del dato a los
        modelos y al producto que el usuario ve—. Bajo cada pilar viven los servicios que entregamos,
        con su alcance y su evidencia.
      </p>
    </header>

    <div class="grid gap-12 md:gap-14">
      {
        pillars.map((pillar) => (
          <section aria-label={`Pilar ${pillar.num}: ${pillar.title}`}>
            <div
              class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-white/10 pb-4"
              data-animate-text
            >
              <h3 class="flex items-baseline gap-3 text-balance">
                <span class="font-mono text-xl font-bold tabular-nums text-blue-300 md:text-2xl">
                  {pillar.num}
                </span>
                <span class="text-xl font-bold tracking-tight text-white md:text-2xl">
                  {pillar.title}
                </span>
              </h3>
              <p class="text-sm text-slate-400">{pillar.subtitle}</p>
            </div>

            <ul
              class="mt-6 grid gap-4 md:gap-5 lg:grid-cols-2"
              data-stagger
              role="list"
            >
              {pillar.services.map((service) => (
                <li
                  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-900/55 p-6 ring-1 ring-white/5 transition duration-300 hover:-translate-y-1 hover:border-blue-400/45 hover:bg-slate-900/80 hover:shadow-xl hover:shadow-blue-950/40"
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 bg-gradient-to-b from-blue-400 to-blue-600 transition-transform duration-300 group-hover:scale-y-100"
                  />
                  <header class="flex items-start justify-between gap-3">
                    <h4 class="text-balance text-[17px] font-semibold leading-snug tracking-tight text-white">
                      {service.name}
                    </h4>
                    <span class="shrink-0 whitespace-nowrap rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 font-mono text-[11px] tabular-nums text-slate-300">
                      {service.time}
                    </span>
                  </header>
                  <p class="mt-3 text-[13.5px] leading-relaxed text-slate-300">
                    <span class="font-semibold text-slate-100">Para:</span> {service.target}
                  </p>
                  <p class="mt-2 text-[13.5px] leading-relaxed text-slate-300">
                    <span class="font-semibold text-slate-100">Incluye:</span> {service.includes}
                  </p>
                  {service.proof && (
                    <span class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-emerald-500/15 px-2.5 py-1 text-[11px] font-medium text-emerald-300 ring-1 ring-emerald-400/30">
                      <span aria-hidden="true">✓</span>
                      {service.proof}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
