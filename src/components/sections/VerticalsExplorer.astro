---
/**
 * VerticalsExplorer.astro
 * -----------------------
 * Verticales especializados: explorador con pestañas (una por sector). Cada
 * panel muestra perfil del cliente, dolores, ofertas insignia, evidencia y
 * métricas de valor.
 *
 * El cambio de pestaña lo gestiona `initVerticalsExplorer()` en
 * `site-animations.ts` (toggle de paneles + estados ARIA, con fade que respeta
 * `prefers-reduced-motion`). Sin JS, el primer panel queda visible y los demás
 * ocultos con `hidden`.
 *
 * Mantiene la línea gráfica oscura (bg-slate-950 + acentos blue/emerald/amber/sky).
 */
import { verticals, type VerticalAccent, type VerticalStatus } from '../../data/verticals';

const accentMap: Record<
  VerticalAccent,
  { border: string; iconBg: string; dot: string }
> = {
  blue: {
    border: 'border-l-blue-500',
    iconBg: 'bg-blue-500/15 text-blue-300 ring-blue-400/30',
    dot: 'bg-blue-400',
  },
  emerald: {
    border: 'border-l-emerald-500',
    iconBg: 'bg-emerald-500/15 text-emerald-300 ring-emerald-400/30',
    dot: 'bg-emerald-400',
  },
  amber: {
    border: 'border-l-amber-500',
    iconBg: 'bg-amber-500/15 text-amber-300 ring-amber-400/30',
    dot: 'bg-amber-400',
  },
  sky: {
    border: 'border-l-sky-400',
    iconBg: 'bg-sky-500/15 text-sky-300 ring-sky-400/30',
    dot: 'bg-sky-400',
  },
};

const statusMap: Record<VerticalStatus, string> = {
  active: 'bg-emerald-500/15 text-emerald-300 ring-1 ring-emerald-400/30',
  priority: 'bg-amber-500/15 text-amber-300 ring-1 ring-amber-400/30',
  next: 'bg-sky-500/15 text-sky-300 ring-1 ring-sky-400/30',
};
---

<section
  id="verticales"
  class="relative scroll-mt-32 overflow-hidden bg-slate-950 py-16 text-slate-100 md:py-24"
  aria-labelledby="verticales-heading"
  data-verticals
  data-animate
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_50%_-15%,rgba(59,130,246,0.16),transparent_55%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto w-[92%] max-w-7xl">
    <header class="mb-8 max-w-3xl md:mb-10">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-400"
        data-animate-text
      >
        Líneas de negocio especializadas
      </p>
      <h2
        id="verticales-heading"
        class="mt-3 text-balance text-3xl font-bold tracking-tight text-white md:text-4xl"
        data-animate-text
      >
        Sectores donde aplicamos los pilares
      </h2>
      <p
        class="mt-4 text-pretty text-base leading-relaxed text-slate-300 md:text-lg"
        data-animate-text
      >
        Cada línea de negocio adapta los pilares a un sector. La electoral está probada en producción;
        las demás reutilizan ese núcleo. Elige un sector.
      </p>
    </header>

    <div
      role="tablist"
      aria-label="Líneas de negocio especializadas"
      class="scrollbar-none mb-8 flex gap-2 overflow-x-auto border-b border-white/10 pb-4"
    >
      {
        verticals.map((v, i) => (
          <button
            type="button"
            role="tab"
            id={`vtab-${v.id}`}
            data-vertical-tab={v.id}
            aria-controls={`vpanel-${v.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-active={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="inline-flex shrink-0 items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-[13px] font-medium text-slate-300 transition hover:border-blue-400/40 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 data-[active=true]:border-blue-400/50 data-[active=true]:bg-blue-500/15 data-[active=true]:text-white"
          >
            <span
              class:list={['inline-block size-2 rounded-full', accentMap[v.accent].dot]}
              aria-hidden="true"
            />
            {v.shortLabel}
          </button>
        ))
      }
    </div>

    {
      verticals.map((v, i) => (
        <div
          role="tabpanel"
          id={`vpanel-${v.id}`}
          data-vertical-panel={v.id}
          aria-labelledby={`vtab-${v.id}`}
          hidden={i !== 0}
          tabindex={v.evidenceHref ? undefined : 0}
        >
          {/* Hero de la vertical */}
          <div
            class:list={[
              'flex items-start gap-4 rounded-2xl border border-white/10 border-l-4 bg-slate-900/55 p-6 ring-1 ring-white/5',
              accentMap[v.accent].border,
            ]}
          >
            <span
              class:list={[
                'inline-flex size-12 shrink-0 items-center justify-center rounded-xl ring-1',
                accentMap[v.accent].iconBg,
              ]}
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-6">
                <path d={v.iconPath} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="text-balance text-lg font-bold tracking-tight text-white md:text-xl">
                {v.name}
              </h3>
              <p class="mt-1 text-pretty text-sm leading-relaxed text-slate-300">{v.tagline}</p>
              <span
                class:list={[
                  'mt-3 inline-block rounded-full px-3 py-1 text-[11px] font-medium',
                  statusMap[v.statusType],
                ]}
              >
                {v.status}
              </span>
            </div>
          </div>

          {/* Perfil del cliente + dolores */}
          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-6">
              <h4 class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">
                Perfil del cliente
              </h4>
              <ul class="mt-4 grid gap-2.5" role="list">
                {v.targets.map((t) => (
                  <li class="flex gap-2.5 text-[13.5px] leading-relaxed text-slate-300">
                    <span class="mt-1.5 inline-block size-1.5 shrink-0 rounded-full bg-blue-400" aria-hidden="true" />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-6">
              <h4 class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">
                Dolor que atendemos
              </h4>
              <ul class="mt-4 grid gap-2.5" role="list">
                {v.pains.map((p) => (
                  <li class="flex gap-2.5 text-[13.5px] leading-relaxed text-slate-300">
                    <span class="mt-0.5 font-bold text-rose-400" aria-hidden="true">!</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* Ofertas insignia */}
          <h4 class="mt-8 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">
            Ofertas insignia
          </h4>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {v.offerings.map((o) => (
              <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-5 transition duration-300 hover:-translate-y-1 hover:border-blue-400/45 hover:bg-slate-900/80 hover:shadow-xl hover:shadow-blue-950/40">
                <p class="text-[14px] font-semibold leading-snug text-white">{o.name}</p>
                <p class="mt-2 text-[13px] leading-relaxed text-slate-300">{o.desc}</p>
              </div>
            ))}
          </div>

          {/* Evidencia */}
          <div
            class:list={[
              'mt-8 rounded-2xl border border-white/10 border-l-4 bg-slate-900/55 p-6',
              accentMap[v.accent].border,
            ]}
          >
            <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-blue-300">
              Evidencia
            </p>
            <p class="mt-1.5 text-[15px] font-semibold text-white">{v.proof.title}</p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-slate-300">{v.proof.desc}</p>
            {v.evidenceHref && (
              <a
                href={v.evidenceHref}
                class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-semibold text-blue-300 transition hover:text-blue-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
              >
                Ver evidencia en producción
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>

          {/* Métricas de valor */}
          <h4 class="mt-8 text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">
            Métricas de valor
          </h4>
          <ul class="mt-4 grid gap-2.5 rounded-2xl border border-white/10 bg-slate-900/40 p-6" role="list">
            {v.metrics.map((m) => (
              <li class="flex gap-2.5 text-[13.5px] leading-relaxed text-slate-300">
                <span class="mt-0.5 font-bold text-emerald-400" aria-hidden="true">✓</span>
                <span>{m}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
