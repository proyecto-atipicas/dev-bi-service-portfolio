---
/**
 * ManagedServicesSection.astro
 * ----------------------------
 * Servicios continuos (managed): operación recurrente sobre proyectos ya
 * atendidos por la Suite BI. Bloque claro con grilla de tarjetas.
 */
import { managedServices } from '../../data/managed-services';
---

<section
  id="continuos"
  class="relative scroll-mt-32 bg-white py-16 text-slate-900 md:py-24"
  aria-labelledby="continuos-heading"
  data-animate
>
  <div class="mx-auto w-[92%] max-w-7xl">
    <header class="mb-10 max-w-3xl md:mb-12">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600"
        data-animate-text
      >
        Servicios continuos
      </p>
      <h2
        id="continuos-heading"
        class="mt-3 text-balance text-3xl font-bold tracking-tight text-slate-900 md:text-4xl"
        data-animate-text
      >
        El portafolio no termina en la entrega
      </h2>
      <p
        class="mt-4 text-pretty text-base leading-relaxed text-slate-600 md:text-lg"
        data-animate-text
      >
        Operamos, optimizamos y hacemos evolucionar los tableros con cadencias acordadas, para que el
        BI siga rindiendo.
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2 md:gap-5" data-stagger role="list">
      {
        managedServices.map((service) => (
          <article
            role="listitem"
            class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-gradient-to-br from-white to-slate-50 p-6 shadow-sm ring-1 ring-slate-900/[0.03] transition duration-300 hover:-translate-y-1 hover:border-blue-300/70 hover:shadow-lg hover:shadow-blue-900/10 md:p-7"
          >
            <header class="flex items-start justify-between gap-3">
              <h3 class="text-balance text-[17px] font-bold leading-snug tracking-tight text-slate-900">
                {service.name}
              </h3>
              <span class="shrink-0 whitespace-nowrap rounded-full border border-blue-100 bg-blue-50 px-2.5 py-1 text-[11px] font-semibold text-blue-700">
                {service.cadence}
              </span>
            </header>
            <p class="mt-3 text-[14px] leading-relaxed text-slate-600">
              <span class="font-semibold text-slate-900">Para:</span> {service.target}
            </p>
            <p class="mt-2 text-[14px] leading-relaxed text-slate-600">
              <span class="font-semibold text-slate-900">Incluye:</span> {service.includes}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
