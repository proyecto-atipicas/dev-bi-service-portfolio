---
import Layout from '../layouts/Layout.astro';
import ServiceSection from '../components/ServiceSection.astro';
import DeliverablesShowcase from '../components/shared/DeliverablesShowcase.astro';
import VerticalTimeline from '../components/shared/VerticalTimeline.astro';
import { indexedServices, services, totalServices } from '../data/services';
import { electionTimeline } from '../data/timeline-elecciones';
import { heroCarouselVideos } from '../data/hero-carousel-videos';

const currentYear = new Date().getFullYear();

/** Repositorio Power BI / Fabric con todos los tableros del ciclo electoral. */
const repositorioPowerBiUrl =
  'https://app.fabric.microsoft.com/view?r=eyJrIjoiMDNhYTFhMDMtZjFlYy00NjY3LThhOGQtMmVjMGY4YmZlMWRmIiwidCI6IjFiZmY4NTRkLWUwY2YtNDEwZi1iY2IwLWQ5NDkzNDQzMWU0MyIsImMiOjR9';

const contactMarqueeTags = [
  'Tableros de control',
  'Análisis electoral',
  'Automatización',
  'Desarrollo a la medida orientado a los datos',
  'Estructuración de bases de datos',
];

/* Cuerpo prediseñado del correo para la mesa de trabajo. */
const mailto = (() => {
  const subject = encodeURIComponent('Mesa de trabajo con el área de BI');
  const body = encodeURIComponent(
    [
      'Hola equipo de BI,',
      '',
      'Me gustaría coordinar una mesa de trabajo para un nuevo requerimiento.',
      '',
      '· Servicio de interés (automatización / reportería / desarrollo / estructuración):',
      '· Contexto / objetivo del requerimiento:',
      '· Resultado esperado:',
      '· Fecha aproximada o ventana de tiempo:',
      '',
      'Gracias por la coordinación.',
    ].join('\n'),
  );
  return `mailto:proyecto.atipicas@linktic.com?subject=${subject}&body=${body}`;
})();
---

<Layout
  title="Linktic · DataVision · Portafolio de Business Intelligence"
  description="Portafolio de servicios de Business Intelligence de Linktic (DataVision): reportería en tres paquetes, automatización, desarrollo a la medida y estructuración de bases de datos para los proyectos de la compañía."
>
  <main class="bg-white text-slate-900">
    {/* HERO */}
    <section
      class="hero-visual relative isolate min-h-[calc(100vh-128px)] overflow-hidden bg-slate-950"
      aria-label="Portafolio de servicios de Business Intelligence"
      data-hero-fullscreen-root
      data-animate
    >
      <div
        class="absolute inset-0 -z-20"
        data-hero-video-carousel
        role="region"
        aria-label="Carrusel de ejemplos en vídeo del portafolio"
      >
        {
          heroCarouselVideos.map((clip, i) => (
            <div
              class:list={[i === 0 ? 'hero-slide--active' : 'hero-slide--idle']}
              data-hero-carousel-slide
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <video
                src={clip.src}
                poster="/portada.png"
                muted
                playsinline
                preload={i === 0 ? 'auto' : 'metadata'}
                autoplay={i === 0}
                aria-label={clip.ariaLabel}
                class="h-full w-full object-cover"
              />
            </div>
          ))
        }
      </div>
      <div
        class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-slate-950/40 via-slate-950/35 to-slate-950/85"
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute inset-x-0 bottom-[5.5rem] z-20 flex justify-center px-4 md:bottom-[6.5rem]"
      >
        <div
          class="pointer-events-auto inline-flex max-w-[min(100%,24rem)] items-center gap-0.5 rounded-full border border-white/[0.08] bg-black/22 py-0.5 pl-0.5 pr-0.5 shadow-[0_1px_0_0_rgba(255,255,255,0.04)_inset,0_8px_24px_-8px_rgba(0,0,0,0.45)] backdrop-blur-sm sm:max-w-none sm:gap-1 sm:py-1 sm:pl-1 sm:pr-1"
          data-hero-carousel-controls
          role="group"
          aria-label="Controles del carrusel de vídeos de fondo"
          tabindex="0"
        >
          {
            heroCarouselVideos.length > 1 && (
              <>
                <button
                  type="button"
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-white/38 transition-[color,background-color] duration-300 ease-out hover:bg-white/[0.06] hover:text-white/72 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-white/35 sm:h-8 sm:w-8"
                  data-hero-carousel-prev
                  aria-label="Vídeo anterior"
                >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-3.5 w-3.5 sm:h-4 sm:w-4"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z"
                    clip-rule="evenodd"
                  />
                </svg>
                </button>
                <div
                  class="scrollbar-none flex min-w-0 max-w-[11.5rem] flex-nowrap items-center justify-center gap-[5px] overflow-x-auto px-0.5 sm:max-w-none sm:gap-1.5 sm:px-1"
                >
                {heroCarouselVideos.map((clip, i) => (
                  <button
                    type="button"
                    data-hero-carousel-dot
                    aria-label={`Ir al vídeo ${i + 1} de ${heroCarouselVideos.length}: ${clip.ariaLabel}`}
                    {...(i === 0 ? { 'data-active': '' } : {})}
                    class="h-1.5 w-1.5 shrink-0 rounded-full bg-white/16 transition-[width,background-color,box-shadow] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-white/28 data-[active]:h-1.5 data-[active]:w-[18px] data-[active]:rounded-full data-[active]:bg-blue-300/45 data-[active]:shadow-[0_0_14px_rgba(125,211,252,0.12)] sm:data-[active]:w-5"
                  />
                ))}
                </div>
                <button
                  type="button"
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-white/38 transition-[color,background-color] duration-300 ease-out hover:bg-white/[0.06] hover:text-white/72 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-white/35 sm:h-8 sm:w-8"
                  data-hero-carousel-next
                  aria-label="Vídeo siguiente"
                >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-3.5 w-3.5 sm:h-4 sm:w-4"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
                    clip-rule="evenodd"
                  />
                </svg>
                </button>
                <span
                  class="mx-0.5 h-4 w-px shrink-0 bg-white/10 sm:mx-1"
                  aria-hidden="true"
                ></span>
              </>
            )
          }
          <button
            type="button"
            role="switch"
            aria-checked="true"
            data-hero-carousel-play
            aria-label="Pausar reproducción del carrusel"
            class="hero-carousel-switch shrink-0"
          >
            <span class="hero-carousel-switch-thumb" aria-hidden="true"></span>
          </button>
          <button
            type="button"
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-white/38 transition-[color,background-color] duration-300 ease-out hover:bg-white/[0.06] hover:text-white/72 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-white/35 sm:h-8 sm:w-8"
            data-hero-carousel-fullscreen
            aria-label="Ver en pantalla completa"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-3.5 w-3.5 sm:h-4 sm:w-4"
              data-fs-enter
              aria-hidden="true"
            >
              <path
                d="M3 4.25A2.25 2.25 0 0 1 5.25 2h2.5a.75.75 0 0 1 0 1.5H5.25a.75.75 0 0 0-.75.75v2.5a.75.75 0 0 1-1.5 0v-2.5ZM14.75 2h-2.5a.75.75 0 0 1 0 1.5h2.5a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 0 1.5 0v-2.5A2.25 2.25 0 0 0 14.75 2ZM3.75 14.75v-2.5a.75.75 0 0 0-1.5 0v2.5A2.25 2.25 0 0 0 4.25 17h2.5a.75.75 0 0 0 0-1.5H4.25a.75.75 0 0 1-.75-.75ZM17 14.75v-2.5a.75.75 0 0 0-1.5 0v2.5A2.25 2.25 0 0 1 14.75 17h-2.5a.75.75 0 0 1 0-1.5h2.5a.75.75 0 0 0 .75-.75Z"
              />
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="hidden h-3.5 w-3.5 sm:h-4 sm:w-4"
              data-fs-exit
              aria-hidden="true"
            >
              <path
                d="M3.75 5.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5H5.25v2.5a.75.75 0 0 1-1.5 0V5.25ZM14.75 4.5a.75.75 0 0 1 1.5 0v2.5A2.25 2.25 0 0 1 14 7.25h-2.5a.75.75 0 0 1 0-1.5h2.5v-2.5ZM4.5 14.75a.75.75 0 0 1-1.5 0v-2.5A2.25 2.25 0 0 1 5.25 12h2.5a.75.75 0 0 1 0 1.5H5.25v2.5ZM15.5 12.25a.75.75 0 0 1 1.5 0v2.5A2.25 2.25 0 0 1 14.75 17h-2.5a.75.75 0 0 1 0-1.5h2.5v-2.5Z"
              />
            </svg>
          </button>
        </div>
      </div>

      <div class="relative mx-auto flex min-h-[calc(100vh-128px)] w-[92%] max-w-7xl flex-col justify-end pb-12 md:pb-16">
        <div class="max-w-3xl">
          <p
            class="text-[11px] font-semibold uppercase tracking-[0.24em] text-blue-300/90"
            data-animate-text
          >
            Linktic · DataVision · Business Intelligence
          </p>
          <h1
            class="mt-4 text-balance text-4xl font-bold leading-tight tracking-tight text-white md:text-6xl md:leading-tight"
            data-animate-text
          >
            Decide con datos confiables.
          </h1>
          <p
            class="mt-5 max-w-xl text-pretty text-base leading-relaxed text-slate-200 md:text-lg md:leading-relaxed"
            data-animate-text
          >
            Portafolio del área de Business Intelligence de Linktic, disponible para todos los proyectos de la compañía.
          </p>
          <div class="mt-7" data-animate-text>
            <a
              href="#servicios"
              class="inline-flex items-center gap-2 rounded-full bg-blue-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-950/40 transition hover:bg-blue-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 md:text-[15px]"
            >
              Ver los servicios
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ÍNDICE HORIZONTAL DE SERVICIOS */}
    <section
      id="servicios"
      class="relative scroll-mt-32 bg-slate-950 py-16 text-slate-100 md:py-20"
      aria-labelledby="indice-servicios-heading"
      data-animate
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_50%_-15%,rgba(59,130,246,0.14),transparent_55%)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto w-[92%] max-w-7xl">
        <header class="mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 md:mb-12">
          <div class="max-w-2xl">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-400"
              data-animate-text
            >
              Acceso rápido
            </p>
            <h2
              id="indice-servicios-heading"
              class="mt-3 text-balance text-3xl font-bold tracking-tight text-white md:text-4xl"
              data-animate-text
            >
              Recorre las cuatro líneas de servicio
            </h2>
            <p
              class="mt-4 text-pretty text-base leading-relaxed text-slate-300 md:text-lg"
              data-animate-text
            >
              Cada tarjeta abre la sección completa del servicio. Pasa el cursor para ver el video; pulsa para saltar
              directamente al detalle, los beneficios y la vitrina de entregables.
            </p>
          </div>
          <span
            class="inline-flex items-baseline gap-3 self-start rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-200 md:self-end"
          >
            <span class="font-mono text-2xl font-bold tabular-nums text-white md:text-3xl">
              {totalServices}
            </span>
            <span class="text-[11px] uppercase tracking-[0.18em] text-slate-400">Servicios</span>
          </span>
        </header>

        <ol
          class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6"
          data-stagger
          aria-label="Índice de servicios"
        >
          {indexedServices.map((service) => (
            <li class="h-full">
              <a
                href={`#${service.anchor}`}
                class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-900/60 ring-1 ring-white/5 transition hover:-translate-y-1 hover:border-blue-400/45 hover:bg-slate-900/80 hover:shadow-xl hover:shadow-blue-950/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                aria-label={`Ir a la sección del servicio ${service.title}`}
              >
                <div class="relative aspect-video w-full overflow-hidden bg-slate-950">
                  <div
                    class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-slate-950/85 via-slate-950/10 to-transparent"
                    aria-hidden="true"
                  ></div>
                  <video
                    data-service-preview
                    src={service.videoSrc}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                    class="relative z-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  ></video>
                  <span
                    class="absolute left-3 top-3 z-20 inline-flex items-center gap-2 rounded-full border border-white/15 bg-slate-950/70 px-2.5 py-1 backdrop-blur"
                  >
                    <span class="font-mono text-[11px] font-semibold tabular-nums text-blue-200">
                      {service.number}
                    </span>
                    <span class="text-[10px] font-medium uppercase tracking-[0.16em] text-slate-300">
                      Servicio
                    </span>
                  </span>
                  <span
                    class="absolute right-3 top-3 z-20 inline-flex size-9 items-center justify-center rounded-full border border-white/15 bg-slate-950/70 text-blue-200 backdrop-blur"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5">
                      <path d={service.iconPath} stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
                <div class="flex flex-1 flex-col gap-2 px-5 py-5">
                  <h3 class="text-balance text-lg font-semibold leading-snug tracking-tight text-white">
                    {service.title}
                  </h3>
                  <p class="text-pretty text-sm leading-relaxed text-slate-300">
                    {service.shortDesc}
                  </p>
                  <span
                    class="mt-auto inline-flex items-center gap-1.5 pt-2 text-[12.5px] font-semibold text-blue-300 transition group-hover:text-blue-200"
                  >
                    Ver detalle
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* SECCIONES DE CADA SERVICIO */}
    <ServiceSection
      service={services.automatizacion}
      number={indexedServices[0].number}
      total={totalServices}
    >
      <DeliverablesShowcase
        items={services.automatizacion.deliverables}
        eyebrow="Vitrina de entregables"
        heading="Servicios de automatización en producción"
        description="Aplicaciones internas y flujos que ya corren de forma autónoma: monitorean KPIs, vigilan bases de datos, orquestan procesos operativos y agilizan trámites documentales."
      />
    </ServiceSection>

    <ServiceSection
      service={services.reporteria}
      number={indexedServices[1].number}
      total={totalServices}
    >
      {/* PAQUETES DE REPORTERÍA: Básico · Medium · Plus
          Catálogo interactivo del servicio. Las tres tarjetas resaltan al
          pasar el cursor y exponen un detalle expandible (<details>) con la
          ficha técnica completa. Mantiene la línea oscura del sitio. */}
      <section
        id="reporteria-paquetes"
        class="relative scroll-mt-32 overflow-hidden bg-slate-950 py-16 text-slate-100 md:py-24"
        aria-labelledby="reporteria-paquetes-heading"
        data-animate
      >
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_55%_at_50%_-15%,rgba(59,130,246,0.18),transparent_55%)]"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
          aria-hidden="true"
        ></div>

        <div class="relative mx-auto w-[92%] max-w-7xl">
          <header class="mx-auto max-w-3xl text-center">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-300"
              data-animate-text
            >
              Catálogo del servicio
            </p>
            <h3
              id="reporteria-paquetes-heading"
              class="mt-3 text-balance text-3xl font-bold tracking-tight text-white md:text-4xl"
              data-animate-text
            >
              Tres paquetes para la reportería de tu proyecto
            </h3>
            <p
              class="mt-4 text-pretty text-base leading-relaxed text-slate-300 md:text-lg"
              data-animate-text
            >
              Cada paquete escala en profundidad, modo de conexión a los datos y experiencia para el usuario final. Pasa el cursor o toca una tarjeta y expande la ficha técnica para conocer el detalle.
            </p>
          </header>

          <div
            class="mt-12 grid gap-5 md:mt-14 md:gap-6 lg:grid-cols-3"
            data-stagger
            role="list"
            aria-label="Paquetes de reportería"
          >
            {/* 01 · Básico */}
            <article
              role="listitem"
              class="pkg-card group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-900/55 p-7 ring-1 ring-white/5 transition duration-300 hover:-translate-y-1.5 hover:border-blue-400/45 hover:bg-slate-900/85 hover:shadow-2xl hover:shadow-blue-950/40 focus-within:-translate-y-1.5 focus-within:border-blue-400/55"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-sky-400/0 via-sky-400/70 to-sky-400/0 transition-transform duration-500 group-hover:scale-x-100"
              ></span>
              <header class="flex items-center justify-between gap-3">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-blue-300">
                  01 · Básico
                </span>
                <span
                  class="rounded-full border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-slate-200"
                >
                  Modo importación
                </span>
              </header>

              <h4 class="mt-5 text-balance text-2xl font-bold tracking-tight text-white">
                Tableros consolidados, listos para consultar
              </h4>

              <p class="mt-3 text-[14.5px] leading-relaxed text-slate-300">
                Implementación visual sobre datos importados al modelo. Ideal para informes que se actualizan en ventanas
                programadas, sin requerir lectura en vivo de la base.
              </p>

              <ul class="pkg-features mt-6 grid gap-3 text-[14px] leading-relaxed text-slate-200">
                <li>Tableros en Power BI o Tableau en modo importación.</li>
                <li>Sincronización programada cada 30&nbsp;minutos.</li>
                <li>Fuentes: Excel, CSV, SharePoint, archivos planos.</li>
                <li>Entrega de un enlace público o privado al tablero.</li>
              </ul>

              <details class="pkg-details mt-6 rounded-xl border border-white/10 bg-white/[0.03] open:bg-white/[0.05]">
                <summary
                  class="flex cursor-pointer select-none items-center justify-between gap-3 px-4 py-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-blue-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400/70"
                >
                  Ficha técnica
                  <span aria-hidden="true" class="pkg-details-chev">+</span>
                </summary>
                <div class="border-t border-white/10 px-4 py-4 text-[13.5px] leading-relaxed text-slate-300">
                  <p>
                    <strong class="font-semibold text-white">Ideal para:</strong> reportes ejecutivos donde la cifra
                    no cambia en tiempo real y donde un refresco cada 30&nbsp;min basta para tomar decisiones.
                  </p>
                  <ul class="mt-3 grid gap-1.5">
                    <li class="text-slate-300">· Datos estáticos en el modelo importado.</li>
                    <li class="text-slate-300">· Herramientas: Power BI, Tableau u otras de visualización.</li>
                    <li class="text-slate-300">· Acceso al tablero por enlace; sin embebido en aplicativo.</li>
                  </ul>
                </div>
              </details>

              <footer class="mt-6 inline-flex items-center gap-1.5 self-start text-[11.5px] font-semibold uppercase tracking-[0.2em] text-slate-400">
                <span class="inline-block size-1.5 rounded-full bg-sky-400/80" aria-hidden="true"></span>
                Refresh · cada 30 min
              </footer>
            </article>

            {/* 02 · Medium */}
            <article
              role="listitem"
              class="pkg-card group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-slate-900/55 p-7 ring-1 ring-white/5 transition duration-300 hover:-translate-y-1.5 hover:border-blue-400/45 hover:bg-slate-900/85 hover:shadow-2xl hover:shadow-blue-950/40 focus-within:-translate-y-1.5 focus-within:border-blue-400/55"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-gradient-to-r from-blue-400/0 via-blue-400/80 to-blue-400/0 transition-transform duration-500 group-hover:scale-x-100"
              ></span>
              <header class="flex items-center justify-between gap-3">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-blue-300">
                  02 · Medium
                </span>
                <span
                  class="rounded-full border border-blue-400/30 bg-blue-500/15 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-blue-100"
                >
                  DirectQuery + RLS
                </span>
              </header>

              <h4 class="mt-5 text-balance text-2xl font-bold tracking-tight text-white">
                Tableros en vivo con seguridad por rol
              </h4>

              <p class="mt-3 text-[14.5px] leading-relaxed text-slate-300">
                Conexión directa a la base de datos para análisis detallado en tiempo real. Embebido autenticado en el
                aplicativo del cliente y filtrado por usuario con RLS.
              </p>

              <ul class="pkg-features mt-6 grid gap-3 text-[14px] leading-relaxed text-slate-200">
                <li>Conexión DirectQuery a la base productiva del cliente.</li>
                <li>Información en tiempo real, sin ventanas de sincronización.</li>
                <li>Seguridad RLS: cada rol ve únicamente sus datos.</li>
                <li>Embebido en el aplicativo del cliente con su propia autenticación.</li>
                <li>Pruebas de estrés y carga sobre los tableros publicados.</li>
              </ul>

              <details class="pkg-details mt-6 rounded-xl border border-white/10 bg-white/[0.03] open:bg-white/[0.05]">
                <summary
                  class="flex cursor-pointer select-none items-center justify-between gap-3 px-4 py-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-blue-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400/70"
                >
                  Ficha técnica
                  <span aria-hidden="true" class="pkg-details-chev">+</span>
                </summary>
                <div class="border-t border-white/10 px-4 py-4 text-[13.5px] leading-relaxed text-slate-300">
                  <p>
                    <strong class="font-semibold text-white">Ideal para:</strong> productos internos de Linktic donde el
                    tablero forma parte del aplicativo y debe respetar los permisos del usuario que ya tiene sesión.
                  </p>
                  <ul class="mt-3 grid gap-1.5">
                    <li class="text-slate-300">· Tiempo de actualización dictado por la fuente original.</li>
                    <li class="text-slate-300">· Autenticación heredada del aplicativo (sin login Microsoft).</li>
                    <li class="text-slate-300">· Validación de rendimiento bajo concurrencia esperada.</li>
                  </ul>
                </div>
              </details>

              <footer class="mt-6 inline-flex items-center gap-1.5 self-start text-[11.5px] font-semibold uppercase tracking-[0.2em] text-blue-200">
                <span class="inline-block size-1.5 rounded-full bg-blue-400" aria-hidden="true"></span>
                Tiempo real · embebido
              </footer>
            </article>

            {/* 03 · Plus — destacado */}
            <article
              role="listitem"
              class="pkg-card pkg-card--featured group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-blue-400/40 bg-gradient-to-br from-blue-500/[0.14] via-slate-900/70 to-slate-900/85 p-7 ring-1 ring-blue-400/15 transition duration-300 hover:-translate-y-1.5 hover:border-blue-300/70 hover:shadow-2xl hover:shadow-blue-900/50 focus-within:-translate-y-1.5 focus-within:border-blue-300/80"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-blue-300/0 via-blue-300/90 to-blue-300/0"
              ></span>
              <header class="flex items-center justify-between gap-3">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.22em] text-blue-200">
                  03 · Plus
                </span>
                <span
                  class="inline-flex items-center gap-1.5 rounded-full border border-blue-300/50 bg-blue-400/20 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white"
                >
                  <span class="size-1.5 rounded-full bg-blue-200 shadow-[0_0_8px_rgba(191,219,254,0.6)]" aria-hidden="true"></span>
                  Experiencia inmersiva
                </span>
              </header>

              <h4 class="mt-5 text-balance text-2xl font-bold tracking-tight text-white">
                Aplicativos inmersivos para eventos en vivo
              </h4>

              <p class="mt-3 text-[14.5px] leading-relaxed text-slate-200">
                Tableros y aplicativos totalmente personalizados con datos en tiempo real, pensados para eventos donde el
                público interactúa con la información en pantalla.
              </p>

              <ul class="pkg-features mt-6 grid gap-3 text-[14px] leading-relaxed text-slate-100">
                <li>Tableros y aplicativos 100&nbsp;% a la medida.</li>
                <li>Información en tiempo real para experiencias en vivo.</li>
                <li>Diseño orientado a UX para eventos y muestras públicas.</li>
                <li>Visualizaciones avanzadas y narrativa interactiva.</li>
                <li>Integra todo lo del paquete Medium.</li>
              </ul>

              <details class="pkg-details mt-6 rounded-xl border border-blue-300/20 bg-white/[0.04] open:bg-white/[0.06]">
                <summary
                  class="flex cursor-pointer select-none items-center justify-between gap-3 px-4 py-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-blue-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300"
                >
                  Ficha técnica
                  <span aria-hidden="true" class="pkg-details-chev">+</span>
                </summary>
                <div class="border-t border-blue-300/15 px-4 py-4 text-[13.5px] leading-relaxed text-slate-200">
                  <p>
                    <strong class="font-semibold text-white">Ideal para:</strong> jornadas, lanzamientos y eventos donde
                    la pantalla en vivo cuenta una historia con los datos del proyecto.
                  </p>
                  <ul class="mt-3 grid gap-1.5">
                    <li>· Render web a la medida (frontend dedicado).</li>
                    <li>· Animaciones y visualizaciones avanzadas.</li>
                    <li>· Conexión en streaming a las fuentes del evento.</li>
                  </ul>
                </div>
              </details>

              <footer class="mt-6 inline-flex items-center gap-1.5 self-start text-[11.5px] font-semibold uppercase tracking-[0.2em] text-blue-100">
                <span class="inline-block size-1.5 rounded-full bg-blue-200 shadow-[0_0_8px_rgba(191,219,254,0.6)]" aria-hidden="true"></span>
                Tiempo real · a la medida
              </footer>
            </article>
          </div>

          {/* Callout: servicio en modo caja negra */}
          <aside
            class="relative mt-14 overflow-hidden rounded-2xl border border-blue-400/25 bg-gradient-to-br from-blue-500/[0.10] via-slate-900/55 to-slate-900/85 p-7 ring-1 ring-blue-400/10 md:mt-16 md:p-9"
            aria-labelledby="reporteria-cajanegra-heading"
            data-animate-text
          >
            <div
              class="pointer-events-none absolute -right-16 -top-16 size-56 rounded-full bg-blue-500/15 blur-3xl"
              aria-hidden="true"
            ></div>
            <div class="relative grid gap-6 md:grid-cols-[auto_1fr_auto] md:items-center md:gap-10">
              <div
                class="flex size-14 items-center justify-center rounded-2xl border border-blue-300/30 bg-blue-500/15 text-blue-100 md:size-16"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-7 md:size-8">
                  <path
                    d="M4 7h16M4 12h16M4 17h10"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                  <path
                    d="M18 16l2 2 3-4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </div>
              <div class="max-w-2xl">
                <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-blue-200">
                  Servicio complementario
                </p>
                <h4
                  id="reporteria-cajanegra-heading"
                  class="mt-2 text-balance text-xl font-bold tracking-tight text-white md:text-2xl"
                >
                  Modo caja negra: entreganos el dato, recíbelo limpio al 99,9&nbsp;%
                </h4>
                <p class="mt-3 text-pretty text-[15px] leading-relaxed text-slate-300 md:text-base">
                  Para los proyectos que prefieren no operar el dato: tú nos entregas la fuente cruda y nosotros la
                  procesamos —limpieza, normalización y análisis— hasta dejarla con un nivel de confiabilidad del
                  <span class="font-semibold text-white"> 99,9&nbsp;%</span>. Aplica como complemento a cualquiera de los
                  tres paquetes anteriores.
                </p>
              </div>
              <ul class="grid gap-2 text-[13px] text-slate-200 md:justify-self-end" aria-label="Etapas del proceso caja negra">
                <li class="inline-flex items-center gap-2">
                  <span class="font-mono text-[11px] font-semibold tabular-nums text-blue-300">01</span>
                  Recepción del dato crudo
                </li>
                <li class="inline-flex items-center gap-2">
                  <span class="font-mono text-[11px] font-semibold tabular-nums text-blue-300">02</span>
                  Limpieza y normalización
                </li>
                <li class="inline-flex items-center gap-2">
                  <span class="font-mono text-[11px] font-semibold tabular-nums text-blue-300">03</span>
                  Análisis y entrega
                </li>
              </ul>
            </div>
          </aside>
        </div>
      </section>

      {/* Repositorio Power BI / Fabric: acceso al consolidado de tableros antes del recorrido cronológico. */}
      <section
        id="reporteria-repositorio"
        class="relative scroll-mt-32 bg-white py-14 md:py-20"
        aria-labelledby="reporteria-repositorio-heading"
      >
        <div class="mx-auto w-[92%] max-w-7xl">
          <header class="mb-8 max-w-3xl md:mb-10">
            <p
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600"
              data-animate-text
            >
              Repositorio completo
            </p>
            <h3
              id="reporteria-repositorio-heading"
              class="mt-3 text-balance text-2xl font-bold tracking-tight text-slate-900 md:text-3xl"
              data-animate-text
            >
              Repositorio de tableros Power BI del ciclo electoral
            </h3>
            <p
              class="mt-4 text-pretty text-base leading-relaxed text-slate-600 md:text-lg"
              data-animate-text
            >
              Vista consolidada con todos los tableros publicados por el área: elecciones atípicas, Congreso, consultas
              y demás despliegues del ciclo. Da clic para abrir el repositorio completo en Power BI.
            </p>
          </header>

          <a
            href={repositorioPowerBiUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 shadow-md ring-1 ring-slate-900/[0.04] transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl hover:shadow-blue-900/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
            aria-label="Abrir el repositorio completo de tableros Power BI"
          >
            <div class="relative aspect-video w-full">
              <iframe
                src={repositorioPowerBiUrl}
                title="Repositorio completo de tableros Power BI del ciclo electoral"
                loading="lazy"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
                class="absolute inset-0 h-full w-full border-0"
              ></iframe>
              {/* Capa transparente que captura el clic del enlace sin bloquear el iframe en hover. */}
              <span class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100 md:p-6">
                <span class="text-[12px] font-semibold uppercase tracking-[0.18em] text-blue-200">
                  Power BI · Repositorio completo
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/95 px-3 py-1.5 text-[12px] font-semibold text-slate-900 shadow-sm">
                  Abrir en pestaña nueva
                  <span aria-hidden="true">↗</span>
                </span>
              </span>
            </div>
          </a>

          <div class="mt-6 flex justify-center md:justify-start" data-animate-text>
            <a
              href={repositorioPowerBiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-blue-950/25 transition hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 md:text-[15px]"
            >
              Ver repositorio completo
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <VerticalTimeline
        id="linea-tiempo-elecciones"
        eyebrow="Vitrina de entregables · Evolución del servicio"
        heading="Línea de tiempo de elecciones atípicas, Congreso 2026 y Presidencia 2026"
        description="Recorrido cronológico de los despliegues publicados por el área durante el ciclo electoral. Cada parada incluye los enlaces a los tableros publicados; en el modo horizontal, pulsa un nodo para abrir el detalle de la elección."
        events={electionTimeline}
      />
    </ServiceSection>

    <ServiceSection
      service={services.desarrollo}
      number={indexedServices[2].number}
      total={totalServices}
    >
      <DeliverablesShowcase
        items={services.desarrollo.deliverables}
        eyebrow="Vitrina de entregables"
        heading="Componentes, APIs y aplicaciones a la medida"
        description="Diagramas de arquitectura, contratos de integración y aplicaciones analíticas construidas a medida del proceso de cada área."
      />
    </ServiceSection>

    <ServiceSection
      service={services.estructuracion}
      number={indexedServices[3].number}
      total={totalServices}
    >
      <DeliverablesShowcase
        items={services.estructuracion.deliverables}
        eyebrow="Vitrina de entregables"
        heading="Modelado, migraciones y sincronización"
        description="Esquemas, historial de migraciones y flujos de sincronización que mantienen los datos consistentes entre sistemas y entornos."
      />
    </ServiceSection>

    {/* CONTACTO */}
    <section
      id="contacto"
      class="relative scroll-mt-32 overflow-x-hidden border-t border-slate-200 bg-white pb-16 pt-12 text-slate-900 md:pb-20 md:pt-16"
      aria-labelledby="contacto-heading"
      data-animate
    >
      <div
        class="relative left-1/2 mb-12 w-screen max-w-none -translate-x-1/2 border-y border-slate-100 bg-slate-50 px-4 py-3 sm:px-8 md:mb-16 md:py-4"
        role="region"
        aria-roledescription="carrusel"
        aria-label="Palabras clave del área de Business Intelligence"
      >
        <div class="slider-fade-x relative min-h-[5.25rem] overflow-hidden sm:min-h-[5.5rem] md:min-h-[5.75rem]">
          <div
            id="contact-tags-slider"
            class="flex h-full overflow-x-auto overscroll-x-contain py-1"
            tabindex="0"
          >
            <div class="flex w-max shrink-0 items-stretch gap-4 sm:gap-5 md:gap-6">
              {[...contactMarqueeTags, ...contactMarqueeTags].map((label, i) => (
                <span
                  class="inline-flex min-h-[4.5rem] w-[13.75rem] shrink-0 items-stretch gap-3 rounded-xl border border-slate-200/95 bg-white p-3 shadow-sm ring-1 ring-slate-950/[0.04] sm:min-h-[4.75rem] sm:w-[15rem] sm:gap-3.5 sm:p-3.5 md:min-h-[5rem] md:w-[16.5rem] md:p-4"
                  aria-hidden={i >= contactMarqueeTags.length ? true : undefined}
                >
                  <span
                    class="w-1 shrink-0 self-stretch rounded-full bg-gradient-to-b from-blue-500 to-blue-600/85"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="flex min-w-0 flex-1 items-center text-pretty text-[13px] font-medium leading-snug tracking-tight text-slate-800 sm:text-sm md:leading-snug"
                  >
                    {label}
                  </span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="relative mx-auto w-[92%] max-w-3xl text-center">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600"
          data-animate-text
        >
          Mesa de trabajo
        </p>
        <h2
          id="contacto-heading"
          class="mt-3 text-balance text-3xl font-bold tracking-tight text-slate-900 md:text-4xl md:leading-tight"
          data-animate-text
        >
          Coordinamos requerimientos con el área de BI
        </h2>
        <p
          class="mx-auto mt-5 max-w-xl text-pretty text-base leading-relaxed text-slate-600 md:text-lg md:leading-relaxed"
          data-animate-text
        >
          Priorizamos iniciativas con cada área, acordamos alcance y entregables, y acompañamos la puesta en marcha
          para que la operación se mantenga estable y la adopción sea efectiva en el día a día.
        </p>

        <div class="mt-9 flex flex-wrap justify-center gap-3" data-animate-text>
          <a
            href={mailto}
            class="cta-header-attention relative inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 md:text-[15px]"
          >
            Escribir al área de BI
          </a>
          <a
            href="mailto:proyecto.atipicas@linktic.com"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 bg-white px-7 py-3.5 text-sm font-semibold text-slate-800 transition hover:border-blue-300 hover:bg-blue-50 hover:text-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 md:text-[15px]"
          >
            proyecto.atipicas@linktic.com
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-white py-8">
    <div class="mx-auto flex w-[92%] max-w-7xl flex-col items-center gap-3 text-center text-sm text-slate-500 md:flex-row md:justify-between md:gap-4 md:text-left">
      <div class="inline-flex items-center gap-3" data-animate-text>
        <img
          src="/logo-negro-LinkTIC.svg"
          alt="Linktic"
          width="96"
          height="14"
          class="h-4 w-auto opacity-80"
          loading="lazy"
          decoding="async"
        />
        <span class="text-slate-400" aria-hidden="true">·</span>
        <span class="font-semibold text-slate-700">
          Data<span class="text-blue-600">Vision</span>
        </span>
      </div>
      <p data-animate-text>
        &copy; {currentYear} Linktic · DataVision (Business Intelligence). Todos los derechos reservados.
      </p>
    </div>
  </footer>

  <script>
    import {
      initContactKeywordSlider,
      initHeroVideoCarousel,
      initHomePageEffects,
    } from '../scripts/site-animations';
    import { initVerticalTimelines } from '../scripts/vertical-timeline';
    try {
      initHeroVideoCarousel();
      initHomePageEffects();
      initContactKeywordSlider();
      initVerticalTimelines();
    } catch (e) {
      console.error('[animaciones] Error en efectos de la home.', e);
    }
  </script>
</Layout>
