---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';
import VerticalTimeline from '../../components/shared/VerticalTimeline.astro';
import { electionTimeline } from '../../data/timeline-elecciones';

export function getStaticPaths() {
  return Object.keys(services).map((idservicio) => ({ params: { idservicio } }));
}

const { idservicio } = Astro.params;
const service = services[idservicio ?? ''];

if (!service) {
  return Astro.redirect('/#servicios');
}

const showElectionTimeline = idservicio === 'reporteria';

const bulletCards = service.bullets ?? [];

type LauncherItem = {
  id: string;
  title: string;
  description: string;
  service: keyof typeof services;
  href?: string;
  comingSoon?: boolean;
};

const ITEMS: LauncherItem[] = [
  {
    id: 'simae',
    title: 'SIMAE',
    description: 'Tablero de experiencia SIMAE (Sistema Integral de monitoreo y analitica electoral).',
    href: 'https://simae.actoreselectorales.com/',
    service: 'reporteria',
  },
  {
    id: 'appbi',
    title: 'AppBI',
    description: 'Aplicación transversal de apoyo para las diferentes áreas del proyecto, para gestión administrativa.',
    href: 'https://appbi.actoreselectorales.com/',
    service: 'automatizacion',
  },
  {
    id: 'seguimiento-data',
    title: 'Seguimiento DATA',
    description: 'Aplicación de monitoreo interno.',
    href: 'https://seguimiento-data.actoreselectorales.com/',
    service: 'automatizacion',
  },
  {
    id: 'embebidos-publicos',
    title: 'Embebidos Públicos',
    description:
      'Aplicación donde se encuentran embebidos los tableros de Power BI, tanto congreso como consulta.',
    href: 'https://presidencia2026.actoreselectorales.com/',
    service: 'reporteria',
  },
  {
    id: 'bot-trafico',
    title: 'Bot Tráfico',
    description: 'Generador de tráfico para el módulo de capacitaciones.',
    href: 'https://botbi.actoreselectorales.com/',
    service: 'automatizacion',
  },
  {
    id: 'descarga-credenciales',
    title: 'Descarga de Credenciales',
    description: 'Herramienta para la descarga de resoluciones y credenciales del sistema CNE.',
    href: 'https://credenciales.actoreselectorales.com/',
    service: 'automatizacion',
  },
  {
    id: 'analitica-presidencia',
    title: 'Analítica de Presidencia',
    description: 'Herramienta de análisis de elecciones presidenciales históricas.',
    href: 'https://analisis-presidencia-colombia.vercel.app/',
    service: 'reporteria',
  },
  {
    id: 'actividades-bi',
    title: 'Actividades BI',
    description: 'Cronograma de planeación de las tareas del área.',
    href: 'https://proyecto-atipicas.github.io/dev-bi-cronograma-actividades-v1/',
    service: 'reporteria',
  },
];

const currentServiceItems = ITEMS.filter((item) => item.service === idservicio);

---

<Layout title={`${service.title} | Servicios BI`} description={service.summary}>
  <main class="bg-white text-slate-900">
    <section
      class="relative isolate scroll-mt-20 bg-slate-950 py-10 md:py-14"
      aria-labelledby="service-page-title"
      data-animate
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(59,130,246,0.16),transparent_55%)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto w-[92%] max-w-7xl">
        <h1
          id="service-page-title"
          class="mb-8 max-w-4xl text-balance text-3xl font-bold tracking-tight text-white md:mb-10 md:text-4xl lg:text-[2.5rem] lg:leading-tight"
          data-animate-text
        >
          {service.title}
        </h1>
        <div
          class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/40 shadow-2xl shadow-black/40 ring-1 ring-white/5"
        >
          <div class="relative aspect-video w-full bg-slate-950">
            <div
              class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/30"
              aria-hidden="true"
            ></div>
            <video
              data-service-preview
              src={service.videoSrc}
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              aria-label={`Video de presentación: ${service.title}`}
              class="service-media relative z-0 h-full w-full object-cover"
            ></video>
          </div>
        </div>
      </div>
    </section>

    <section
      id="descripcion-servicio"
      class="scroll-mt-20 border-b border-slate-200 bg-white py-14 md:py-20"
      aria-labelledby="descripcion-heading"
      data-animate
    >
      <div class="mx-auto w-[92%] max-w-7xl">
        <header class="mb-10 max-w-3xl md:mb-12">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600" data-animate-text>
            Qué es este servicio
          </p>
          <h2
            id="descripcion-heading"
            class="mt-3 text-balance text-2xl font-bold tracking-tight text-slate-900 md:text-3xl"
            data-animate-text
          >
            Alcance y componentes
          </h2>
          <p class="mt-4 text-pretty text-base leading-relaxed text-slate-600" data-animate-text>
            La descripción resume el valor entregado al negocio; las tarjetas desglosan capacidades concretas que pueden
            combinarse según la necesidad de cada iniciativa.
          </p>
        </header>

        <div class="grid gap-4 md:grid-cols-2 md:gap-5 lg:gap-6" data-stagger>
          <article
            class="md:col-span-2 rounded-2xl border border-slate-200/90 bg-slate-50/80 p-6 shadow-sm ring-1 ring-slate-900/[0.03] md:p-8"
          >
            <div class="flex items-baseline gap-2">
              <span class="font-mono text-xs font-medium tabular-nums text-blue-600">00</span>
              <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Visión general</span>
            </div>
            <p class="mt-4 text-pretty text-[15px] leading-relaxed text-slate-700 md:text-base md:leading-relaxed">
              {service.summary}
            </p>
          </article>

          {
            bulletCards.map((text, i) => (
              <article
                class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-sm ring-1 ring-slate-900/[0.03] md:p-7"
              >
                <div class="flex items-baseline gap-2">
                  <span class="font-mono text-xs font-medium tabular-nums text-blue-600">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Componente</span>
                </div>
                <p class="mt-4 text-pretty text-sm leading-relaxed text-slate-700 sm:text-[15px] sm:leading-relaxed">
                  {text}
                </p>
              </article>
            ))
          }
        </div>

        {
          service.modalityA && service.modalityB && (
            <div class="mt-10 grid gap-4 md:grid-cols-2 md:gap-5">
              <article
                class="rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-7"
                data-animate-text
              >
                <h3 class="font-semibold text-slate-900">Modalidad A: Tableros Power BI</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{service.modalityA}</p>
              </article>
              <article
                class="rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-7"
                data-animate-text
              >
                <h3 class="font-semibold text-slate-900">Modalidad B: Desarrollo a medida</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600">{service.modalityB}</p>
              </article>
            </div>
          )
        }

        {service.closing && (
          <p
            class="mt-10 max-w-3xl text-pretty text-base leading-relaxed text-slate-600"
            data-animate-text
          >
            {service.closing}
          </p>
        )}
      </div>
    </section>

    {
      showElectionTimeline && (
        <VerticalTimeline
          id="linea-tiempo-elecciones"
          eyebrow="Evolución del servicio"
          heading="Línea de tiempo de elecciones atípicas, Congreso 2026 y Presidencia 2026"
          description="Recorrido cronológico de los tableros que ha publicado el área de Business Intelligence durante el ciclo electoral. Cada parada concentra la fecha, el contexto y los tableros embebidos del despliegue, e ilustra cómo ha madurado la práctica de reportería al pasar de las atípicas locales a los hitos nacionales."
          events={electionTimeline}
        />
      )
    }

    <section
      id="casos-exito"
      class="scroll-mt-20 bg-slate-50 py-14 md:py-20"
      aria-labelledby="casos-heading"
      data-animate
    >
      <div class="mx-auto w-[92%] max-w-7xl">
        <header class="mb-8 max-w-3xl md:mb-10">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600" data-animate-text>
            Impacto
          </p>
          <h2
            id="casos-heading"
            class="mt-3 text-balance text-2xl font-bold tracking-tight text-slate-900 md:text-3xl"
            data-animate-text
          >
            Casos de éxito
          </h2>
          <p class="mt-4 text-pretty text-base leading-relaxed text-slate-600" data-animate-text>
            Referencias de implementación y resultados medibles. Esta sección se ampliará conforme se publiquen las
            historias aprobadas para difusión interna.
          </p>
        </header>

        <div class="grid gap-4 sm:grid-cols-2">
            {
              currentServiceItems.length > 0 ? currentServiceItems.map((item) => (
                <article
                  class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm ring-1 ring-slate-900/[0.03]"
                  data-animate-text
                >
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-sm font-semibold text-slate-900">{item.title}</h3>
                    {item.comingSoon && (
                      <span class="rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-500">
                        Próximamente
                      </span>
                    )}
                  </div>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>

                  {item.href && !item.comingSoon && (
                    <>
                      <div class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
                        <iframe
                          src={item.href}
                          title={`Vista previa de ${item.title}`}
                          loading="lazy"
                          class="h-64 w-full"
                        ></iframe>
                      </div>
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-3 inline-flex text-xs font-semibold text-blue-700 hover:text-blue-800"
                      >
                        Abrir en pestaña nueva
                      </a>
                    </>
                  )}
                </article>
              )) : (
                <article
                  class="sm:col-span-2 rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600"
                  data-animate-text
                >
                  Aún no hay casos de éxito publicados para este servicio.
                </article>
              )
            }
        </div>
      </div>
    </section>

    <div class="border-t border-slate-200 bg-white py-10">
      <div class="mx-auto flex w-[92%] max-w-7xl flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
        <a
          href="/#servicios"
          class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 shadow-sm transition hover:border-blue-300 hover:bg-blue-50 hover:text-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          data-animate-text
        >
          <span aria-hidden="true">←</span>
          Volver al listado de servicios
        </a>
      </div>
    </div>
  </main>

  <script>
    import { initHomePageEffects } from '../../scripts/site-animations';
    import { initVerticalTimelines } from '../../scripts/vertical-timeline';
    try {
      initHomePageEffects();
      initVerticalTimelines();
    } catch (e) {
      console.error('[animaciones] Error en página de detalle de servicio.', e);
    }
  </script>
</Layout>
