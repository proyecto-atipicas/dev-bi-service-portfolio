---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Business Intelligence',
	description = 'Servicios de Business Intelligence, reportería y automatización de KPIs.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-black antialiased">
		<SiteHeader />
		<slot />
		<script>
			import { initNavAndTextAnimations } from '../scripts/site-animations';
			try {
				initNavAndTextAnimations();
			} catch (e) {
				console.error('[animaciones] Error al iniciar animaciones.', e);
			}
		</script>
	</body>
</html>
